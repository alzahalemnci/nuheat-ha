{
    "openapi": "3.0.4",
    "info": {
        "title": "Open API",
        "version": "2.0"
    },
    "paths": {
        "/api/v2/Account": {
            "get": {
                "tags": [
                    "Account"
                ],
                "summary": "Get the AccountModel.",
                "responses": {
                    "200": {
                        "description": "Successful Response.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AccountModel"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "If user is not authorized."
                    },
                    "500": {
                        "description": "Failed to retrieve user account. Internal Server Error."
                    }
                }
            }
        },
        "/api/v2/Mode/Auto": {
            "put": {
                "tags": [
                    "Mode"
                ],
                "summary": "Set thermostat mode to Auto.",
                "requestBody": {
                    "description": "Auto mode settings.",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ModeAuto"
                            }
                        },
                        "text/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ModeAuto"
                            }
                        },
                        "application/*+json": {
                            "schema": {
                                "$ref": "#/components/schemas/ModeAuto"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "Successful Response."
                    },
                    "400": {
                        "description": "If request is invalid."
                    },
                    "401": {
                        "description": "If user is not authorized."
                    },
                    "404": {
                        "description": "If the thermostat cannot be found for provided serial number."
                    },
                    "500": {
                        "description": "Failed to set Auto mode for thermostat. Internal Server Error."
                    }
                }
            }
        },
        "/api/v2/Mode/Hold": {
            "put": {
                "tags": [
                    "Mode"
                ],
                "summary": "Set thermostat mode to Hold.",
                "requestBody": {
                    "description": "Hold mode settings.",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ModeHold"
                            }
                        },
                        "text/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ModeHold"
                            }
                        },
                        "application/*+json": {
                            "schema": {
                                "$ref": "#/components/schemas/ModeHold"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "Successful Response."
                    },
                    "400": {
                        "description": "If request is invalid."
                    },
                    "401": {
                        "description": "If user is not authorized."
                    },
                    "404": {
                        "description": "If the thermostat cannot be found for provided serial number."
                    },
                    "500": {
                        "description": "Failed to set Auto mode for thermostat. Internal Server Error."
                    }
                }
            }
        },
        "/api/v2/Mode/Manual": {
            "put": {
                "tags": [
                    "Mode"
                ],
                "summary": "Set thermostat mode to Manual.",
                "requestBody": {
                    "description": "Manual mode settings.",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ModeManual"
                            }
                        },
                        "text/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ModeManual"
                            }
                        },
                        "application/*+json": {
                            "schema": {
                                "$ref": "#/components/schemas/ModeManual"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "Successful Response."
                    },
                    "400": {
                        "description": "If request is invalid."
                    },
                    "401": {
                        "description": "If user is not authorized."
                    },
                    "404": {
                        "description": "If the thermostat cannot be found for provided serial number."
                    },
                    "500": {
                        "description": "Failed to set Auto mode for thermostat. Internal Server Error."
                    }
                }
            }
        },
        "/api/v2/Thermostat": {
            "get": {
                "tags": [
                    "Thermostat"
                ],
                "summary": "Get the list of ThermostatModel.",
                "responses": {
                    "200": {
                        "description": "Returns the thermostat model.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ThermostatModel"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "If the user is not authorized."
                    },
                    "404": {
                        "description": "If the thermostats list is empty."
                    },
                    "500": {
                        "description": "Failed to retrieve thermostats. Internal Server Error."
                    }
                }
            }
        },
        "/api/v2/Thermostat/{serialNumber}": {
            "get": {
                "tags": [
                    "Thermostat"
                ],
                "summary": "Retrieves a specific thermostat model by its serial number.",
                "parameters": [
                    {
                        "name": "serialNumber",
                        "in": "path",
                        "description": "The serial number of the thermostat to retrieve.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Returns the thermostat model.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ThermostatModel"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "If the user input is not valid."
                    },
                    "401": {
                        "description": "If the user is not authorized."
                    },
                    "404": {
                        "description": "If the thermostat is not found."
                    },
                    "500": {
                        "description": "If there is an internal server error."
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AccountModel": {
                "type": "object",
                "properties": {
                    "userName": {
                        "type": "string",
                        "description": "Gets or sets first name of the account owner.",
                        "nullable": true
                    },
                    "temperatureScale": {
                        "type": "string",
                        "description": "Gets or sets first name of the account owner.",
                        "nullable": true
                    },
                    "language": {
                        "type": "string",
                        "description": "Gets or sets first name of the account owner.",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "ModeAuto": {
                "required": [
                    "serialNumber"
                ],
                "type": "object",
                "properties": {
                    "serialNumber": {
                        "minLength": 1,
                        "type": "string",
                        "description": "Gets or sets the thermostat serial number."
                    }
                },
                "additionalProperties": false
            },
            "ModeHold": {
                "required": [
                    "serialNumber"
                ],
                "type": "object",
                "properties": {
                    "serialNumber": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "temperature": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "holdUntil": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "temperatureType": {
                        "$ref": "#/components/schemas/eTemperatureType"
                    }
                },
                "additionalProperties": false
            },
            "ModeManual": {
                "required": [
                    "serialNumber"
                ],
                "type": "object",
                "properties": {
                    "serialNumber": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "temperature": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "temperatureType": {
                        "$ref": "#/components/schemas/eTemperatureType"
                    }
                },
                "additionalProperties": false
            },
            "ThermostatModel": {
                "type": "object",
                "properties": {
                    "serialNumber": {
                        "type": "string",
                        "nullable": true
                    },
                    "name": {
                        "type": "string",
                        "nullable": true
                    },
                    "currentTemperature": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "online": {
                        "type": "boolean"
                    },
                    "isHeating": {
                        "type": "boolean"
                    },
                    "setPointTemperature": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "holdUntil": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "mode": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "errorState": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "eTemperatureType": {
                "enum": [
                    0,
                    1
                ],
                "type": "integer",
                "description": "Controls how temperature is interpreted: 0 = Absolute uses the value as the setpoint;\n1 = Relative adds the value to the current thermostat temperature.",
                "format": "int32"
            }
        },
        "securitySchemes": {
            "oauth2": {
                "type": "oauth2",
                "description": "OAuth2 Implicit Grant (IdentityServer)",
                "flows": {
                    "implicit": {
                        "authorizationUrl": "https://identity.mynuheat.com/connect/authorize",
                        "scopes": {
                            "openapi": "Open API"
                        }
                    }
                }
            }
        }
    },
    "security": [
        {
            "oauth2": []
        }
    ]
}
